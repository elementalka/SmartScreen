{
  "firstRunCompleted": false,
  "startMinimizedToTray": true,
  "minimizeToTrayOnClose": true,
  "screenshots": {
    "defaultFormat": "png",
    "jpegQuality": 90,
    "fileNameTemplate": "screenshot_{yyyy-MM-dd}_{HH-mm-ss}",
    "defaultMode": "region",
    "copyToClipboardAutomatically": true,
    "showQuickActionsAfterCapture": true,
    "afterCaptureActions": [
      "copyImageToClipboard",
      "showQuickActions"
    ],
    "delaySeconds": 3,
    "monitorIndex": 0,
    "saveDirectory": "screenshots"
  },
  "editor": {
    "defaultColor": "#E53935",
    "defaultStrokeThickness": 3,
    "defaultTextSize": 18,
    "highlighterOpacity": 0.35
  },
  "ai": {
    "activeProviderId": "gemini-flash",
    "sendScreenshotsOnlyAfterConfirmation": true,
    "providers": [
      {
        "id": "gemini-pro",
        "displayName": "Google Gemini Pro",
        "kind": "gemini",
        "endpoint": "https://generativelanguage.googleapis.com/v1beta",
        "apiKey": "",
        "model": "gemini-3-pro-preview",
        "systemPrompt": "You are a helpful assistant that analyzes screenshots clearly and safely.",
        "timeoutSeconds": 90,
        "isEnabled": true
      },
      {
        "id": "gemini-flash",
        "displayName": "Google Gemini Flash",
        "kind": "gemini",
        "endpoint": "https://generativelanguage.googleapis.com/v1beta",
        "apiKey": "",
        "model": "gemini-flash-latest",
        "systemPrompt": "You are a helpful assistant that analyzes screenshots clearly and safely.",
        "timeoutSeconds": 60,
        "isEnabled": true
      },
      {
        "id": "nvidia",
        "displayName": "NVIDIA NIM Vision",
        "kind": "openAiCompatible",
        "endpoint": "https://integrate.api.nvidia.com/v1/chat/completions",
        "apiKey": "",
        "model": "meta/llama-3.2-90b-vision-instruct",
        "systemPrompt": "You are a helpful assistant that analyzes screenshots clearly and safely.",
        "timeoutSeconds": 60,
        "isEnabled": true
      },
      {
        "id": "nvidia-nano-vl",
        "displayName": "NVIDIA Nemotron Nano VL",
        "kind": "openAiCompatible",
        "endpoint": "https://integrate.api.nvidia.com/v1/chat/completions",
        "apiKey": "",
        "model": "nvidia/llama-3.1-nemotron-nano-vl-8b-v1",
        "systemPrompt": "You are a helpful assistant that analyzes screenshots clearly and safely.",
        "timeoutSeconds": 60,
        "isEnabled": true
      },
      {
        "id": "openrouter",
        "displayName": "OpenRouter",
        "kind": "openAiCompatible",
        "endpoint": "https://openrouter.ai/api/v1/chat/completions",
        "apiKey": "",
        "model": "google/gemini-2.5-flash",
        "systemPrompt": "You are a helpful assistant that analyzes screenshots clearly and safely.",
        "timeoutSeconds": 60,
        "isEnabled": true
      },
      {
        "id": "custom-openai-compatible",
        "displayName": "Custom OpenAI-compatible",
        "kind": "openAiCompatible",
        "endpoint": "http://localhost:1234/v1/chat/completions",
        "apiKey": "",
        "model": "local-vision-model",
        "systemPrompt": "You are a helpful assistant that analyzes screenshots clearly and safely.",
        "timeoutSeconds": 60,
        "isEnabled": false
      }
    ]
  },
  "theme": {
    "mode": "system",
    "accentColor": "#2F7DFF"
  },
  "language": "uk-UA"
}
