<Window x:Class="SmartScreen.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartScreen"
        Width="980"
        Height="690"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource GlassWindowBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="204" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource SideRail}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="SmartScreen"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="центр захоплень"
                               Foreground="#A9B7CA"
                               Margin="0,4,0,22" />

                    <TextBlock Text="Захоплення"
                               Foreground="#8EA0B8"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />

                    <Button Style="{StaticResource RailButton}" Command="{Binding CaptureRegionCommand}" AutomationProperties.Name="Область">
                        <DockPanel LastChildFill="True">
                            <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,10,0" />
                            <TextBlock Text="Область" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource RailButton}" Command="{Binding CaptureFullScreenCommand}" AutomationProperties.Name="Весь екран">
                        <DockPanel LastChildFill="True">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,10,0" />
                            <TextBlock Text="Весь екран" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource RailButton}" Command="{Binding CaptureActiveWindowCommand}" AutomationProperties.Name="Активне вікно">
                        <DockPanel LastChildFill="True">
                            <TextBlock Text="&#xE7C4;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,10,0" />
                            <TextBlock Text="Активне вікно" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource RailButton}" Command="{Binding AskAiCommand}" AutomationProperties.Name="Запитати AI">
                        <DockPanel LastChildFill="True">
                            <TextBlock Text="AI" FontSize="13" FontWeight="Bold" Margin="0,0,10,0" />
                            <TextBlock Text="Запитати AI" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="#D90B1220"
                            BorderBrush="#42506A"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Основний хоткей"
                                       Foreground="#9FB0C7"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Ctrl+Shift+S"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="{Binding WorkflowSummary}"
                                       Foreground="#B7C4D8"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource RailButton}" Command="{Binding OpenSettingsCommand}" AutomationProperties.Name="Налаштування">
                        <DockPanel LastChildFill="True">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,10,0" />
                            <TextBlock Text="Налаштування" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Робочий центр" Style="{StaticResource TitleText}" />
                        <Border Style="{StaticResource StatusBadge}" Margin="14,4,0,0">
                            <TextBlock Text="у треї"
                                       Foreground="{StaticResource SuccessBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Status}"
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource GhostButton}"
                            Command="{Binding OpenScreenshotsFolderCommand}"
                            AutomationProperties.Name="Скріншоти"
                            Width="42"
                            MinWidth="42"
                            Padding="0"
                            Margin="0,0,8,0"
                            ToolTip="Відкрити папку скріншотів">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" />
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenSettingsCommand}"
                            AutomationProperties.Name="Налаштування"
                            Width="42"
                            MinWidth="42"
                            Padding="0"
                            ToolTip="Налаштування">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" />
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource WorkspacePanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="280" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Поточний скріншот" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="{Binding SelectedCapture.Summary, TargetNullValue=Очікує захоплення}"
                                           Style="{StaticResource MutedText}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Background="#F00B1220"
                                    BorderBrush="#2E3A52"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    ClipToBounds="True"
                                    Margin="0,16,0,14">
                                <Grid>
                                    <Image Source="{Binding SelectedCapture.PreviewImage}"
                                           Stretch="Uniform"
                                           Visibility="{Binding SelectedCapturePreviewVisibility}" />
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding EmptyPreviewVisibility}">
                                        <TextBlock Text="Немає скріншоту"
                                                   Foreground="#F8FAFC"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Ctrl+Shift+S"
                                                   Foreground="#A9B7CA"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <UniformGrid Grid.Row="2" Columns="3">
                                <Button Style="{StaticResource DashboardActionButton}" Command="{Binding CaptureRegionCommand}" AutomationProperties.Name="Скріншот області" ToolTip="Скріншот області">
                                    <StackPanel>
                                        <TextBlock Text="&#xE8A7;" Style="{StaticResource ActionIconText}" />
                                        <TextBlock Text="Область" Style="{StaticResource ActionCaptionText}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DashboardActionButton}" Command="{Binding CaptureActiveWindowCommand}" AutomationProperties.Name="Скріншот активного вікна" ToolTip="Скріншот активного вікна">
                                    <StackPanel>
                                        <TextBlock Text="&#xE7C4;" Style="{StaticResource ActionIconText}" />
                                        <TextBlock Text="Вікно" Style="{StaticResource ActionCaptionText}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DashboardActionButton}" Command="{Binding AskAiCommand}" AutomationProperties.Name="Запитати AI про поточний скріншот" ToolTip="Запитати AI про поточний скріншот">
                                    <StackPanel>
                                        <TextBlock Text="AI" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                        <TextBlock Text="AI" Style="{StaticResource ActionCaptionText}" />
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource WorkspacePanel}" Margin="0,0,8,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="210" />
                                </Grid.RowDefinitions>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Останні скріншоти" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="{Binding RecentCaptures.Count, StringFormat={}{0} у сесії}"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,4,0,0" />
                                </StackPanel>

                                <Grid Grid.Row="1">
                                    <Border Style="{StaticResource MetricPanel}"
                                            Visibility="{Binding EmptyHistoryVisibility}">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Історія сесії порожня"
                                                       FontWeight="SemiBold"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="Після захоплення тут з'явиться прев'ю."
                                                       Style="{StaticResource MutedText}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <ListBox ItemsSource="{Binding RecentCaptures}"
                                             SelectedItem="{Binding SelectedCapture}"
                                             Style="{StaticResource HistoryListBox}"
                                             ItemContainerStyle="{StaticResource HistoryListBoxItem}"
                                             Visibility="{Binding HistoryListVisibility}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource MetricPanel}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="72" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="62"
                                                                Height="46"
                                                                Background="#E7EDF7"
                                                                CornerRadius="8"
                                                                ClipToBounds="True">
                                                            <Image Source="{Binding PreviewImage}" Stretch="UniformToFill" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                                            <TextBlock Text="{Binding FileName}" Foreground="#7A8595" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <Border Style="{StaticResource WorkspacePanel}">
                                <StackPanel>
                                    <TextBlock Text="Активний AI-маршрут" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="{Binding ActiveProviderName}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Margin="0,12,0,0"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ActiveProviderModel}"
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                    <Border Background="#FFFFF7ED"
                                            BorderBrush="#FFFED7AA"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10"
                                            Margin="0,14,0,0">
                                        <TextBlock Text="лише за дією користувача"
                                                   Foreground="{StaticResource WarningBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource WorkspacePanel}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Сценарій" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="{Binding WorkflowSummary}"
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,14" />
                                    <TextBlock Text="1. Захоплення" Style="{StaticResource CompactLine}" FontWeight="SemiBold" />
                                    <TextBlock Text="2. Буфер або файл" Style="{StaticResource CompactLine}" FontWeight="SemiBold" />
                                    <TextBlock Text="3. Редактор, AI, папка" Style="{StaticResource CompactLine}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Style="{StaticResource FloatingPanelBorder}"
                    Padding="12"
                    Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Status}"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding StorageSummary}"
                               Foreground="#7A8595"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
