<Window x:Class="SmartScreen.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartScreen"
        Width="1120"
        Height="720"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource SideRail}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="SmartScreen"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="центр захоплень"
                               Foreground="#9AA7BA"
                               Margin="0,4,0,24" />

                    <TextBlock Text="Захоплення"
                               Foreground="#8EA0B8"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <Button Style="{StaticResource RailButton}"
                            Command="{Binding CaptureRegionCommand}"
                            Content="Область" />
                    <Button Style="{StaticResource RailButton}"
                            Command="{Binding CaptureFullScreenCommand}"
                            Content="Весь екран" />
                    <Button Style="{StaticResource RailButton}"
                            Command="{Binding CaptureActiveWindowCommand}"
                            Content="Активне вікно" />
                    <Button Style="{StaticResource RailButton}"
                            Command="{Binding AskAiCommand}"
                            Content="Запитати AI" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="#0B1220"
                            BorderBrush="#253148"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Гарячий виклик"
                                       Foreground="#8EA0B8"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Ctrl+Shift+S"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="{Binding WorkflowSummary}"
                                       Foreground="#9AA7BA"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource RailButton}"
                            Command="{Binding OpenSettingsCommand}"
                            Content="Налаштування" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Робочий центр" Style="{StaticResource TitleText}" />
                        <Border Style="{StaticResource StatusBadge}" Margin="14,4,0,0">
                            <TextBlock Text="у треї"
                                       Foreground="{StaticResource SuccessBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Status}"
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource GhostButton}"
                            Command="{Binding OpenScreenshotsFolderCommand}"
                            Content="Скріншоти"
                            Margin="0,0,8,0" />
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenSettingsCommand}"
                            Content="Налаштування" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.22*" />
                    <ColumnDefinition Width="0.88*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource WorkspacePanel}" Margin="0,0,16,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <StackPanel>
                                <TextBlock Text="Поточний скріншот" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="{Binding SelectedCapture.Summary, TargetNullValue=Очікує захоплення}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <Border Grid.Row="1"
                                Background="#0B1220"
                                BorderBrush="#202B3D"
                                BorderThickness="1"
                                CornerRadius="8"
                                ClipToBounds="True"
                                Margin="0,16,0,16">
                            <Grid>
                                <Image Source="{Binding SelectedCapture.PreviewImage}"
                                       Stretch="Uniform"
                                       Visibility="{Binding SelectedCapturePreviewVisibility}" />
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding EmptyPreviewVisibility}">
                                    <TextBlock Text="Немає скріншоту"
                                               Foreground="#F8FAFC"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Ctrl+Shift+S"
                                               Foreground="#9AA7BA"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <UniformGrid Grid.Row="2" Columns="3">
                            <Button Style="{StaticResource ActionButton}"
                                    Command="{Binding CaptureRegionCommand}"
                                    Content="Область" />
                            <Button Style="{StaticResource ActionButton}"
                                    Command="{Binding CaptureActiveWindowCommand}"
                                    Content="Вікно"
                                    Margin="8,0,8,0" />
                            <Button Style="{StaticResource PrimaryActionButton}"
                                    Command="{Binding AskAiCommand}"
                                    Content="AI" />
                        </UniformGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource WorkspacePanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Останні скріншоти" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="{Binding RecentCaptures.Count, StringFormat={}{0} у сесії}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="1">
                            <Border Style="{StaticResource MetricPanel}"
                                    Visibility="{Binding EmptyHistoryVisibility}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Історія сесії порожня"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Після захоплення тут буде прев’ю"
                                               Style="{StaticResource MutedText}"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <ListBox ItemsSource="{Binding RecentCaptures}"
                                     SelectedItem="{Binding SelectedCapture}"
                                     Style="{StaticResource HistoryListBox}"
                                     ItemContainerStyle="{StaticResource HistoryListBoxItem}"
                                     Visibility="{Binding HistoryListVisibility}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource MetricPanel}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="84" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="72"
                                                        Height="48"
                                                        Background="#E7EDF7"
                                                        CornerRadius="8"
                                                        ClipToBounds="True">
                                                    <Image Source="{Binding PreviewImage}" Stretch="UniformToFill" />
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Summary}"
                                                               Style="{StaticResource MutedText}"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding FileName}"
                                                               Foreground="#7A8595"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Background="#FFFFFF"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,18,0,0">
                <DockPanel>
                    <TextBlock Text="{Binding Status}"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding StorageSummary}"
                               Foreground="#7A8595"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Column="2" Margin="0,24,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource WorkspacePanel}">
                <StackPanel>
                    <TextBlock Text="Активний AI-маршрут" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="{Binding ActiveProviderName}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ActiveProviderModel}"
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <Border Background="#FFF7ED"
                            BorderBrush="#FED7AA"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,14,0,0">
                        <TextBlock Text="лише за дією користувача"
                                   Foreground="{StaticResource WarningBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="12" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource WorkspacePanel}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Сценарій" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="{Binding WorkflowSummary}"
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,14" />

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="1. Захоплення"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <TextBlock Grid.Row="1"
                                   Text="2. Буфер + швидкі дії"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <TextBlock Grid.Row="2"
                                   Text="3. Редактор, файл, AI, папка"
                                   FontWeight="SemiBold" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource WorkspacePanel}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Наступні модулі" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="Постійна історія"
                               Style="{StaticResource CompactLine}"
                               Margin="0,14,0,8" />
                    <TextBlock Text="After-capture пресети"
                               Style="{StaticResource CompactLine}" />
                    <TextBlock Text="Редактор hotkeys"
                               Style="{StaticResource CompactLine}" />
                    <TextBlock Text="Запис екрана"
                               Style="{StaticResource CompactLine}" />
                    <TextBlock Text="OCR та image effects"
                               Style="{StaticResource CompactLine}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
