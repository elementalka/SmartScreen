<Window x:Class="SmartScreen.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartScreen" Height="520" Width="860"
        MinHeight="460" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True">
            <StackPanel>
                <TextBlock Text="SmartScreen" Style="{StaticResource TitleText}" />
                <TextBlock Text="Скріншоти, редагування й AI-аналіз екрана" Style="{StaticResource MutedText}" />
            </StackPanel>
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding OpenSettingsCommand}"
                    Content="Налаштування" />
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,28,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <Button Style="{StaticResource PrimaryActionButton}"
                        Command="{Binding CaptureRegionCommand}"
                        Content="Скріншот області" />
                <Button Style="{StaticResource ActionButton}"
                        Command="{Binding CaptureFullScreenCommand}"
                        Content="Скріншот всього екрана" />
                <Button Style="{StaticResource ActionButton}"
                        Command="{Binding CaptureActiveWindowCommand}"
                        Content="Скріншот активного вікна" />
                <Button Style="{StaticResource ActionButton}"
                        Command="{Binding AskAiCommand}"
                        Content="Запитати AI про поточний скріншот" />
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource PanelBorder}">
                <StackPanel>
                    <TextBlock Text="Статус" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <Separator Margin="0,18" />
                    <TextBlock Text="Базовий сценарій працює без AI-ключа. AI-запит надсилається тільки після твоєї явної дії."
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="HotkeyService і tray підключимо наступним шаром поверх уже робочого ядра."
                   Style="{StaticResource MutedText}" />
    </Grid>
</Window>

