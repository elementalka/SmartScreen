<Window x:Class="SmartScreen.App.Views.FirstRunWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.firstRun.title}"
        Width="780"
        Height="560"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource GlassWindowBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{DynamicResource Loc.app.title}" Style="{StaticResource TitleText}" />
            <TextBlock Text="{DynamicResource Loc.firstRun.status}"
                       Style="{StaticResource MutedText}"
                       Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,24,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource WorkspacePanel}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.firstRun.behaviorTitle}" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="{DynamicResource Loc.firstRun.behaviorDescription}"
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,18" />

                    <TextBlock Text="{DynamicResource Loc.firstRun.language}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding LanguageOptions}"
                              SelectedValue="{Binding Settings.Language}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Label"
                              MinHeight="38" />

                    <TextBlock Text="{DynamicResource Loc.firstRun.theme}" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                    <ComboBox x:Name="ThemeModeComboBox"
                              ItemsSource="{Binding ThemeModeOptions}"
                              SelectedValue="{Binding Settings.Theme.Mode}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Label"
                              SelectionChanged="ThemeModeComboBox_OnSelectionChanged"
                              MinHeight="38" />

                    <TextBlock Text="{DynamicResource Loc.firstRun.screenshotsFolder}" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                    <TextBox Text="{Binding Settings.Screenshots.SaveDirectory, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource WorkspacePanel}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.firstRun.afterCaptureTitle}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{DynamicResource Loc.firstRun.afterCaptureDescription}"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,6,0,16" />
                        <CheckBox Content="{DynamicResource Loc.firstRun.copyClipboard}"
                                  IsChecked="{Binding CopyAfterCapture}" />
                        <CheckBox Content="{DynamicResource Loc.firstRun.showQuickMenu}"
                                  IsChecked="{Binding QuickActionsAfterCapture}"
                                  Margin="0,12,0,0" />
                        <CheckBox Content="{DynamicResource Loc.firstRun.openEditor}"
                                  IsChecked="{Binding OpenEditorAfterCapture}"
                                  Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource WorkspacePanel}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.firstRun.aiRouteTitle}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{DynamicResource Loc.firstRun.aiRouteDescription}"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,6,0,16" />
                        <ComboBox ItemsSource="{Binding Providers}"
                                  SelectedItem="{Binding SelectedProvider}"
                                  DisplayMemberPath="DisplayName"
                                  MinHeight="38" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="2">
            <TextBlock Text="{DynamicResource Loc.firstRun.hotkeys}"
                       Style="{StaticResource MutedText}"
                       VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right"
                    Content="{DynamicResource Loc.firstRun.start}"
                    Command="{Binding CompleteCommand}"
                    IsDefault="True"
                    Style="{StaticResource PrimarySmallButton}" />
        </DockPanel>
    </Grid>
</Window>
