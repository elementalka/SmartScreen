<Window x:Class="SmartScreen.App.Views.FirstRunWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Перший запуск SmartScreen"
        Width="780"
        Height="560"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="SmartScreen" Style="{StaticResource TitleText}" />
            <TextBlock Text="{Binding Status}"
                       Style="{StaticResource MutedText}"
                       Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,24,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource WorkspacePanel}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="Базова поведінка" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="Програма працює з трею, а основне вікно відкривається для налаштувань."
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,18" />

                    <TextBlock Text="Мова" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding LanguageOptions}"
                              SelectedValue="{Binding Settings.Language}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Label"
                              MinHeight="38" />

                    <TextBlock Text="Тема" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                    <ComboBox ItemsSource="{Binding ThemeModeOptions}"
                              SelectedValue="{Binding Settings.Theme.Mode}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Label"
                              MinHeight="38" />

                    <TextBlock Text="Папка скріншотів" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                    <TextBox Text="{Binding Settings.Screenshots.SaveDirectory, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource WorkspacePanel}">
                    <StackPanel>
                        <TextBlock Text="Після скріншоту" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="Це можна змінити пізніше в налаштуваннях."
                                   Style="{StaticResource MutedText}"
                                   Margin="0,6,0,16" />
                        <CheckBox Content="Копіювати в буфер"
                                  IsChecked="{Binding CopyAfterCapture}" />
                        <CheckBox Content="Показувати швидке меню"
                                  IsChecked="{Binding QuickActionsAfterCapture}"
                                  Margin="0,12,0,0" />
                        <CheckBox Content="Одразу відкривати редактор"
                                  IsChecked="{Binding OpenEditorAfterCapture}"
                                  Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource WorkspacePanel}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="AI-маршрут" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="Ключ можна додати після майстра в AI settings."
                                   Style="{StaticResource MutedText}"
                                   Margin="0,6,0,16" />
                        <ComboBox ItemsSource="{Binding Providers}"
                                  SelectedItem="{Binding SelectedProvider}"
                                  DisplayMemberPath="DisplayName"
                                  MinHeight="38" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="2">
            <TextBlock Text="Default hotkeys: Ctrl+Shift+S, Ctrl+Shift+F, Ctrl+Shift+W, Ctrl+Shift+A"
                       Style="{StaticResource MutedText}"
                       VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right"
                    Content="Почати"
                    Command="{Binding CompleteCommand}"
                    IsDefault="True"
                    Style="{StaticResource PrimarySmallButton}" />
        </DockPanel>
    </Grid>
</Window>
