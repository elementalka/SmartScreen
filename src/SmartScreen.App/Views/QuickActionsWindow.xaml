<Window x:Class="SmartScreen.App.Views.QuickActionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartScreen actions"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#990B1220">
    <Grid>
        <Viewbox Stretch="Uniform" Margin="28,28,28,98">
            <Grid x:Name="EditingSurface" Background="Transparent">
                <Image x:Name="WorkspaceImage" Stretch="Fill" />
                <Canvas x:Name="AnnotationCanvas"
                        Background="Transparent"
                        MouseLeftButtonDown="AnnotationCanvas_OnMouseLeftButtonDown"
                        MouseMove="AnnotationCanvas_OnMouseMove"
                        MouseLeftButtonUp="AnnotationCanvas_OnMouseLeftButtonUp" />
                <InkCanvas x:Name="InkCanvas"
                           Background="Transparent"
                           EditingMode="Ink" />
            </Grid>
        </Viewbox>

        <Border x:Name="ActionPanel"
                Style="{StaticResource FloatingPanelBorder}"
                MaxWidth="680"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="18"
                Opacity="0.96">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Скріншот готовий" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding ScreenshotInfo}"
                                   Style="{StaticResource MutedText}"
                                   FontSize="12"
                                   Margin="14,0,0,0" />
                    </DockPanel>
                    <TextBlock Text="{Binding Status}"
                               Style="{StaticResource MutedText}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />

                    <UniformGrid Columns="6" Margin="0,12,0,0">
                        <Button Style="{StaticResource FloatingActionButton}" Command="{Binding SaveCommand}" AutomationProperties.Name="Зберегти файл" ToolTip="Зберегти файл">
                            <StackPanel>
                                <TextBlock Text="&#xE74E;" Style="{StaticResource ActionIconText}" />
                                <TextBlock Text="Файл" Style="{StaticResource ActionCaptionText}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FloatingActionButton}" Command="{Binding CopyCommand}" AutomationProperties.Name="Копіювати в буфер" ToolTip="Скопіювати в буфер">
                            <StackPanel>
                                <TextBlock Text="&#xE8C8;" Style="{StaticResource ActionIconText}" />
                                <TextBlock Text="Буфер" Style="{StaticResource ActionCaptionText}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FloatingActionButton}" Click="EditOverlayButton_OnClick" AutomationProperties.Name="Редагувати скріншот" ToolTip="Редагувати скріншот">
                            <StackPanel>
                                <TextBlock Text="&#xE70F;" Style="{StaticResource ActionIconText}" />
                                <TextBlock Text="Редаг." Style="{StaticResource ActionCaptionText}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FloatingActionButton}" Command="{Binding AskAiCommand}" AutomationProperties.Name="Запитати AI" ToolTip="Відкрити AI-панель">
                            <StackPanel>
                                <TextBlock Text="AI" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="Запит" Style="{StaticResource ActionCaptionText}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FloatingActionButton}" Command="{Binding OpenFolderCommand}" AutomationProperties.Name="Відкрити папку" ToolTip="Відкрити папку скріншотів">
                            <StackPanel>
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource ActionIconText}" />
                                <TextBlock Text="Папка" Style="{StaticResource ActionCaptionText}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FloatingActionButton}" Click="CloseButton_OnClick" AutomationProperties.Name="Закрити overlay" ToolTip="Закрити overlay">
                            <StackPanel>
                                <TextBlock Text="&#xE711;" Style="{StaticResource ActionIconText}" />
                                <TextBlock Text="Закр." Style="{StaticResource ActionCaptionText}" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource CloseGlyphButton}"
                        Content="&#xE711;"
                        Click="CloseButton_OnClick"
                        ToolTip="Закрити" />
            </Grid>
        </Border>

        <Grid x:Name="EditorPanel"
              Margin="16"
              Visibility="Collapsed">
            <Border x:Name="EditorRail"
                    Style="{StaticResource EditorGlassPanelBorder}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                <StackPanel>
                    <Button x:Name="PenToolButton" Content="✎" Click="PenButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="Олівець (P)" />
                    <Button x:Name="HighlighterToolButton" Content="▰" Click="HighlighterButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="Маркер (M)" />
                    <Button x:Name="LineToolButton" Content="╱" Click="LineButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="Лінія (L)" />
                    <Button x:Name="ArrowToolButton" Content="→" Click="ArrowButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="Стрілка (A)" />
                    <Button x:Name="RectangleToolButton" Content="□" Click="RectangleButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="Прямокутник (R)" />
                    <Button x:Name="EllipseToolButton" Content="○" Click="EllipseButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="Еліпс (E)" />
                    <Button x:Name="TextToolButton" Content="T" Click="TextButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="Текст (T)" />
                    <Button x:Name="CropToolButton" Content="⌗" Click="CropButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="Обрізання (C)" />
                    <Button x:Name="BlurToolButton" Content="◌" Click="BlurButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="Розмиття (B)" />
                    <Button x:Name="PixelateToolButton" Content="▦" Click="PixelateButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="Пікселізація (X)" />
                    <Button Content="◐" Click="ToggleEditorChromeButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="Сховати панелі (H)" />
                    <Rectangle Height="1" Fill="#4B5C76" Margin="4,4,4,10" />
                    <Button Content="↶" Click="UndoButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="Скасувати (Ctrl+Z)" />
                    <Button Content="↷" Click="RedoButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="Повторити (Ctrl+Y)" />
                    <Button Content="⌫" Click="ClearButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="Очистити позначки" />
                    <Button Content="✓" Click="DoneEditButton_OnClick" Style="{StaticResource EditorCommitButton}" ToolTip="Застосувати (Ctrl+S або Enter)" />
                    <Button Content="×" Click="CancelEditButton_OnClick" Style="{StaticResource EditorCancelButton}" ToolTip="Скасувати редактор (Esc)" />
                </StackPanel>
            </Border>

            <Button x:Name="EditorPeekButton"
                    Content="›"
                    Click="ToggleEditorChromeButton_OnClick"
                    Style="{StaticResource EditorToolButton}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    ToolTip="Показати панелі (H)"
                    Visibility="Collapsed" />

            <Border x:Name="EditorOptionsPanel"
                    Style="{StaticResource EditorGlassPanelBorder}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    MaxWidth="920"
                    Margin="82,0,82,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="ActiveColorPreview"
                                Width="32"
                                Height="32"
                                CornerRadius="8"
                                Background="#E53935"
                                BorderBrush="#E5F0FF"
                                BorderThickness="2"
                                Margin="0,0,10,0" />

                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button x:Name="RoseColorButton" Style="{StaticResource ColorSwatchButton}" Background="#F43F5E" Tag="#F43F5E" Click="ColorButton_OnClick" ToolTip="Rose" />
                            <Button x:Name="RedColorButton" Style="{StaticResource ColorSwatchButton}" Background="#EF4444" Tag="#EF4444" Click="ColorButton_OnClick" ToolTip="Red" />
                            <Button x:Name="OrangeColorButton" Style="{StaticResource ColorSwatchButton}" Background="#F97316" Tag="#F97316" Click="ColorButton_OnClick" ToolTip="Orange" />
                            <Button x:Name="AmberColorButton" Style="{StaticResource ColorSwatchButton}" Background="#F59E0B" Tag="#F59E0B" Click="ColorButton_OnClick" ToolTip="Amber" />
                            <Button x:Name="YellowColorButton" Style="{StaticResource ColorSwatchButton}" Background="#FACC15" Tag="#FACC15" Click="ColorButton_OnClick" ToolTip="Yellow" />
                            <Button x:Name="LimeColorButton" Style="{StaticResource ColorSwatchButton}" Background="#84CC16" Tag="#84CC16" Click="ColorButton_OnClick" ToolTip="Lime" />
                            <Button x:Name="GreenColorButton" Style="{StaticResource ColorSwatchButton}" Background="#22C55E" Tag="#22C55E" Click="ColorButton_OnClick" ToolTip="Green" />
                            <Button x:Name="MintColorButton" Style="{StaticResource ColorSwatchButton}" Background="#10B981" Tag="#10B981" Click="ColorButton_OnClick" ToolTip="Mint" />
                            <Button x:Name="CyanColorButton" Style="{StaticResource ColorSwatchButton}" Background="#06B6D4" Tag="#06B6D4" Click="ColorButton_OnClick" ToolTip="Cyan" />
                            <Button x:Name="SkyColorButton" Style="{StaticResource ColorSwatchButton}" Background="#38BDF8" Tag="#38BDF8" Click="ColorButton_OnClick" ToolTip="Sky" />
                            <Button x:Name="BlueColorButton" Style="{StaticResource ColorSwatchButton}" Background="#2563EB" Tag="#2563EB" Click="ColorButton_OnClick" ToolTip="Blue" />
                            <Button x:Name="IndigoColorButton" Style="{StaticResource ColorSwatchButton}" Background="#4F46E5" Tag="#4F46E5" Click="ColorButton_OnClick" ToolTip="Indigo" />
                            <Button x:Name="VioletColorButton" Style="{StaticResource ColorSwatchButton}" Background="#8B5CF6" Tag="#8B5CF6" Click="ColorButton_OnClick" ToolTip="Violet" />
                            <Button x:Name="PinkColorButton" Style="{StaticResource ColorSwatchButton}" Background="#EC4899" Tag="#EC4899" Click="ColorButton_OnClick" ToolTip="Pink" />
                            <Button x:Name="WhiteColorButton" Style="{StaticResource ColorSwatchButton}" Background="#F8FAFC" Tag="#F8FAFC" Click="ColorButton_OnClick" ToolTip="White" />
                            <Button x:Name="SlateColorButton" Style="{StaticResource ColorSwatchButton}" Background="#64748B" Tag="#64748B" Click="ColorButton_OnClick" ToolTip="Slate" />
                            <Button x:Name="InkColorButton" Style="{StaticResource ColorSwatchButton}" Background="#111827" Tag="#111827" Click="ColorButton_OnClick" ToolTip="Ink" />
                        </WrapPanel>
                    </Grid>

                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Лінія" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Slider x:Name="StrokeSlider" Grid.Column="1" Minimum="1" Maximum="32" Value="4" VerticalAlignment="Center" ValueChanged="EditorSlider_OnValueChanged" />
                        <TextBlock Grid.Column="2" Text="Текст" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,8,0" />
                        <Slider x:Name="TextSizeSlider" Grid.Column="3" Minimum="12" Maximum="64" Value="24" VerticalAlignment="Center" ValueChanged="EditorSlider_OnValueChanged" />
                        <Button x:Name="ShapeFillButton"
                                Grid.Column="4"
                                Content="◐"
                                Click="ShapeFillButton_OnClick"
                                Style="{StaticResource EditorOptionButton}"
                                ToolTip="Напівпрозора заливка фігур (F)" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource AiPanelBorder}"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Width="460"
                MaxHeight="720"
                Margin="24"
                Visibility="{Binding AiPanelVisibility}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38"
                            Height="38"
                            CornerRadius="8"
                            Background="{StaticResource AccentBrush}"
                            Margin="0,0,12,0">
                        <TextBlock Text="AI"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="AI-панель" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding AiStatus}" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource CloseGlyphButton}" Content="&#xE711;" Command="{Binding CloseAiPanelCommand}" ToolTip="Закрити AI-панель" />
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,14,0,12">
                    <TextBlock Text="AI-дія" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Prompts}"
                              SelectedItem="{Binding SelectedPrompt}"
                              MinHeight="36">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}"
                                           Foreground="{StaticResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Prompt" Style="{StaticResource FieldLabel}" Margin="0,10,0,6" />
                    <TextBox Text="{Binding CustomPrompt, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             MinHeight="88"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>

                <TextBox Grid.Row="2"
                         Text="{Binding AiResponseText, Mode=OneWay}"
                         Style="{StaticResource ModernResponseTextBox}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         MinHeight="180" />

                <UniformGrid Grid.Row="3" Columns="4" Margin="0,12,0,0">
                    <Button Command="{Binding RunAiCommand}" Style="{StaticResource FloatingActionButton}" AutomationProperties.Name="Надіслати AI-запит" ToolTip="Надіслати запит">
                        <StackPanel>
                            <TextBlock Text="&#xE768;" Style="{StaticResource ActionIconText}" />
                            <TextBlock Text="Запит" Style="{StaticResource ActionCaptionText}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CancelAiCommand}" Style="{StaticResource FloatingActionButton}" AutomationProperties.Name="Скасувати AI-запит" ToolTip="Скасувати запит">
                        <StackPanel>
                            <TextBlock Text="&#xE71A;" Style="{StaticResource ActionIconText}" />
                            <TextBlock Text="Стоп" Style="{StaticResource ActionCaptionText}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CopyAiResponseCommand}" Style="{StaticResource FloatingActionButton}" AutomationProperties.Name="Копіювати AI-відповідь" ToolTip="Скопіювати відповідь">
                        <StackPanel>
                            <TextBlock Text="&#xE8C8;" Style="{StaticResource ActionIconText}" />
                            <TextBlock Text="Копія" Style="{StaticResource ActionCaptionText}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveAiResponseCommand}" Style="{StaticResource FloatingActionButton}" AutomationProperties.Name="Зберегти AI-відповідь" ToolTip="Зберегти відповідь у файл">
                        <StackPanel>
                            <TextBlock Text="&#xE74E;" Style="{StaticResource ActionIconText}" />
                            <TextBlock Text="Файл" Style="{StaticResource ActionCaptionText}" />
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
