<Window x:Class="SmartScreen.App.Views.QuickActionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartScreen actions"
        Width="650"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent">
    <Border Style="{StaticResource FloatingPanelBorder}" Margin="18">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="148" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="132" Height="86" CornerRadius="8" ClipToBounds="True" Background="#EEF2F8">
                <Image Source="{Binding PreviewImage}" Stretch="UniformToFill" />
            </Border>

            <StackPanel Grid.Column="1" Margin="16,0,14,0">
                <DockPanel>
                    <StackPanel>
                        <TextBlock Text="Скріншот готовий" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" FontSize="12" />
                    </StackPanel>
                </DockPanel>

                <UniformGrid Columns="5" Margin="0,14,0,0">
                    <Button Style="{StaticResource FloatingActionButton}"
                            Command="{Binding SaveCommand}"
                            Content="Зберегти"
                            ToolTip="Зберегти у файл" />
                    <Button Style="{StaticResource FloatingActionButton}"
                            Command="{Binding CopyCommand}"
                            Content="Копія"
                            ToolTip="Скопіювати в буфер" />
                    <Button Style="{StaticResource FloatingActionButton}"
                            Command="{Binding EditCommand}"
                            Content="Редактор"
                            ToolTip="Відкрити редактор" />
                    <Button Style="{StaticResource FloatingActionButton}"
                            Command="{Binding AskAiCommand}"
                            Content="AI"
                            ToolTip="Запитати AI" />
                    <Button Style="{StaticResource FloatingActionButton}"
                            Command="{Binding OpenFolderCommand}"
                            Content="Папка"
                            ToolTip="Відкрити папку скріншотів" />
                </UniformGrid>
            </StackPanel>

            <Button Grid.Column="2"
                    Style="{StaticResource CloseGlyphButton}"
                    Content="×"
                    Click="CloseButton_OnClick"
                    ToolTip="Закрити" />
        </Grid>
    </Border>
</Window>
