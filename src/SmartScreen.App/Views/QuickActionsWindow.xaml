<Window x:Class="SmartScreen.App.Views.QuickActionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartScreen actions"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#990B1220">
    <Grid>
        <Viewbox Stretch="Uniform" Margin="28,28,28,98">
            <Grid x:Name="EditingSurface" Background="Transparent">
                <Image x:Name="WorkspaceImage" Stretch="Fill" />
                <Canvas x:Name="AnnotationCanvas"
                        Background="Transparent"
                        MouseLeftButtonDown="AnnotationCanvas_OnMouseLeftButtonDown"
                        MouseMove="AnnotationCanvas_OnMouseMove"
                        MouseLeftButtonUp="AnnotationCanvas_OnMouseLeftButtonUp" />
                <InkCanvas x:Name="InkCanvas"
                           Background="Transparent"
                           EditingMode="Ink" />
            </Grid>
        </Viewbox>

        <Border x:Name="ActionPanel"
                Style="{StaticResource FloatingPanelBorder}"
                MaxWidth="720"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="18"
                Opacity="0.96">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Скріншот готовий" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding ScreenshotInfo}"
                                   Style="{StaticResource MutedText}"
                                   FontSize="12"
                                   Margin="14,0,0,0" />
                    </DockPanel>
                    <TextBlock Text="{Binding Status}"
                               Style="{StaticResource MutedText}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />

                    <UniformGrid Columns="6" Margin="0,12,0,0">
                        <Button Style="{StaticResource FloatingActionButton}" Command="{Binding SaveCommand}" ToolTip="Зберегти файл">
                            <StackPanel>
                                <TextBlock Text="&#xE74E;" Style="{StaticResource ActionIconText}" />
                                <TextBlock Text="Файл" Style="{StaticResource ActionCaptionText}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FloatingActionButton}" Command="{Binding CopyCommand}" ToolTip="Скопіювати в буфер">
                            <StackPanel>
                                <TextBlock Text="&#xE8C8;" Style="{StaticResource ActionIconText}" />
                                <TextBlock Text="Буфер" Style="{StaticResource ActionCaptionText}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FloatingActionButton}" Click="EditOverlayButton_OnClick" ToolTip="Редагувати скріншот">
                            <StackPanel>
                                <TextBlock Text="&#xE70F;" Style="{StaticResource ActionIconText}" />
                                <TextBlock Text="Редаг." Style="{StaticResource ActionCaptionText}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FloatingActionButton}" Command="{Binding AskAiCommand}" ToolTip="Відкрити AI-панель">
                            <StackPanel>
                                <TextBlock Text="AI" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="Запит" Style="{StaticResource ActionCaptionText}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FloatingActionButton}" Command="{Binding OpenFolderCommand}" ToolTip="Відкрити папку скріншотів">
                            <StackPanel>
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource ActionIconText}" />
                                <TextBlock Text="Папка" Style="{StaticResource ActionCaptionText}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FloatingActionButton}" Click="CloseButton_OnClick" ToolTip="Закрити overlay">
                            <StackPanel>
                                <TextBlock Text="&#xE711;" Style="{StaticResource ActionIconText}" />
                                <TextBlock Text="Закр." Style="{StaticResource ActionCaptionText}" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource CloseGlyphButton}"
                        Content="&#xE711;"
                        Click="CloseButton_OnClick"
                        ToolTip="Закрити" />
            </Grid>
        </Border>

        <Grid x:Name="EditorPanel"
              Margin="16"
              Visibility="Collapsed">
            <Border x:Name="EditorRail"
                    Style="{StaticResource EditorGlassPanelBorder}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                <StackPanel>
                    <Button x:Name="PenToolButton" Content="✎" Click="PenButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="Олівець (P)" />
                    <Button x:Name="HighlighterToolButton" Content="▰" Click="HighlighterButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="Маркер (M)" />
                    <Button x:Name="LineToolButton" Content="╱" Click="LineButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="Лінія (L)" />
                    <Button x:Name="ArrowToolButton" Content="→" Click="ArrowButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="Стрілка (A)" />
                    <Button x:Name="RectangleToolButton" Content="□" Click="RectangleButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="Прямокутник (R)" />
                    <Button x:Name="EllipseToolButton" Content="○" Click="EllipseButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="Еліпс (E)" />
                    <Button x:Name="TextToolButton" Content="T" Click="TextButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="Текст (T)" />
                    <Button x:Name="CropToolButton" Content="⌗" Click="CropButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="Обрізання (C)" />
                    <Button x:Name="BlurToolButton" Content="◌" Click="BlurButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="Розмиття (B)" />
                    <Button x:Name="PixelateToolButton" Content="▦" Click="PixelateButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="Пікселізація (X)" />
                    <Button Content="◐" Click="ToggleEditorChromeButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="Сховати панелі (H)" />
                    <Rectangle Height="1" Fill="#4B5C76" Margin="4,4,4,10" />
                    <Button Content="↶" Click="UndoButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="Скасувати (Ctrl+Z)" />
                    <Button Content="↷" Click="RedoButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="Повторити (Ctrl+Y)" />
                    <Button Content="⌫" Click="ClearButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="Очистити позначки" />
                    <Button Content="✓" Click="DoneEditButton_OnClick" Style="{StaticResource EditorCommitButton}" ToolTip="Застосувати (Ctrl+S або Enter)" />
                    <Button Content="×" Click="CancelEditButton_OnClick" Style="{StaticResource EditorCancelButton}" ToolTip="Скасувати редактор (Esc)" />
                </StackPanel>
            </Border>

            <Button x:Name="EditorPeekButton"
                    Content="›"
                    Click="ToggleEditorChromeButton_OnClick"
                    Style="{StaticResource EditorToolButton}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    ToolTip="Показати панелі (H)"
                    Visibility="Collapsed" />

            <Border x:Name="EditorOptionsPanel"
                    Style="{StaticResource EditorGlassPanelBorder}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    MaxWidth="760"
                    Margin="82,0,82,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="RedColorButton" Style="{StaticResource ColorSwatchButton}" Background="#E53935" Tag="#E53935" Click="ColorButton_OnClick" ToolTip="Червоний" />
                        <Button x:Name="BlueColorButton" Style="{StaticResource ColorSwatchButton}" Background="#2563EB" Tag="#2563EB" Click="ColorButton_OnClick" ToolTip="Синій" />
                        <Button x:Name="GreenColorButton" Style="{StaticResource ColorSwatchButton}" Background="#14966D" Tag="#14966D" Click="ColorButton_OnClick" ToolTip="Зелений" />
                        <Button x:Name="AmberColorButton" Style="{StaticResource ColorSwatchButton}" Background="#F59E0B" Tag="#F59E0B" Click="ColorButton_OnClick" ToolTip="Жовтий" />
                        <Button x:Name="InkColorButton" Style="{StaticResource ColorSwatchButton}" Background="#111827" Tag="#111827" Click="ColorButton_OnClick" ToolTip="Темний" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="Лінія" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,8,0" />
                    <Slider x:Name="StrokeSlider" Grid.Column="2" Minimum="1" Maximum="28" Value="4" VerticalAlignment="Center" ValueChanged="EditorSlider_OnValueChanged" />
                    <TextBlock Grid.Column="3" Text="Текст" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,8,0" />
                    <Slider x:Name="TextSizeSlider" Grid.Column="4" Minimum="14" Maximum="48" Value="24" VerticalAlignment="Center" ValueChanged="EditorSlider_OnValueChanged" />
                </Grid>
            </Border>
        </Grid>

        <Border Style="{StaticResource FloatingPanelBorder}"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Width="420"
                MaxHeight="720"
                Margin="24"
                Opacity="0.96"
                Visibility="{Binding AiPanelVisibility}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <StackPanel>
                        <TextBlock Text="AI" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding AiStatus}" Style="{StaticResource MutedText}" FontSize="12" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource CloseGlyphButton}" Content="&#xE711;" Command="{Binding CloseAiPanelCommand}" ToolTip="Закрити AI-панель" />
                </DockPanel>

                <StackPanel Grid.Row="1" Margin="0,14,0,12">
                    <TextBlock Text="AI-дія" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Prompts}"
                              SelectedItem="{Binding SelectedPrompt}"
                              DisplayMemberPath="Title"
                              MinHeight="36" />
                    <TextBlock Text="Prompt" Style="{StaticResource FieldLabel}" Margin="0,10,0,6" />
                    <TextBox Text="{Binding CustomPrompt, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             MinHeight="88"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>

                <TextBox Grid.Row="2"
                         Text="{Binding AiResponseText, Mode=OneWay}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         MinHeight="180" />

                <UniformGrid Grid.Row="3" Columns="4" Margin="0,12,0,0">
                    <Button Command="{Binding RunAiCommand}" Style="{StaticResource FloatingActionButton}" ToolTip="Надіслати запит">
                        <StackPanel>
                            <TextBlock Text="&#xE768;" Style="{StaticResource ActionIconText}" />
                            <TextBlock Text="Запит" Style="{StaticResource ActionCaptionText}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CancelAiCommand}" Style="{StaticResource FloatingActionButton}" ToolTip="Скасувати запит">
                        <StackPanel>
                            <TextBlock Text="&#xE71A;" Style="{StaticResource ActionIconText}" />
                            <TextBlock Text="Стоп" Style="{StaticResource ActionCaptionText}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CopyAiResponseCommand}" Style="{StaticResource FloatingActionButton}" ToolTip="Скопіювати відповідь">
                        <StackPanel>
                            <TextBlock Text="&#xE8C8;" Style="{StaticResource ActionIconText}" />
                            <TextBlock Text="Копія" Style="{StaticResource ActionCaptionText}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveAiResponseCommand}" Style="{StaticResource FloatingActionButton}" ToolTip="Зберегти відповідь у файл">
                        <StackPanel>
                            <TextBlock Text="&#xE74E;" Style="{StaticResource ActionIconText}" />
                            <TextBlock Text="Файл" Style="{StaticResource ActionCaptionText}" />
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
