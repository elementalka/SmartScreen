<Window x:Class="SmartScreen.App.Views.ScreenshotOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="{StaticResource OverlayScrimBrush}"
        Cursor="Cross">
    <Canvas x:Name="OverlayCanvas"
            Background="Transparent"
            MouseLeftButtonDown="OverlayCanvas_OnMouseLeftButtonDown"
            MouseMove="OverlayCanvas_OnMouseMove"
            MouseLeftButtonUp="OverlayCanvas_OnMouseLeftButtonUp"
            KeyDown="OverlayCanvas_OnKeyDown"
            Focusable="True">
        <Border x:Name="HintPanel"
                Canvas.Top="28"
                Background="{StaticResource OverlayHintBrush}"
                BorderBrush="{StaticResource OverlayHintBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="SmartScreen" FontWeight="SemiBold" Foreground="{StaticResource OverlayHintTextBrush}" />
                <TextBlock Text="{DynamicResource Loc.overlay.selectRegionHint}"
                           Margin="8,0,0,0"
                           Foreground="{StaticResource OverlayHintMutedTextBrush}" />
            </StackPanel>
        </Border>

        <Rectangle x:Name="SelectionRectangle"
                   Stroke="{StaticResource OverlaySelectionStrokeBrush}"
                   StrokeThickness="2"
                   Fill="{StaticResource OverlaySelectionFillBrush}"
                   Visibility="Collapsed" />

        <Border x:Name="SizeBadge"
                Background="{StaticResource OverlayHintBrush}"
                BorderBrush="{StaticResource OverlayHintBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,5"
                Visibility="Collapsed">
            <TextBlock x:Name="SizeBadgeText"
                       Foreground="{StaticResource OverlayHintTextBrush}"
                       FontWeight="SemiBold"
                       FontSize="12" />
        </Border>
    </Canvas>
</Window>
