<Window x:Class="SmartScreen.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.settings.title}"
        Width="1080"
        Height="740"
        MinWidth="920"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource GlassWindowBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="SettingsNavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="11">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlSelectedBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource FocusBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,18,0">
                <TextBlock Text="{DynamicResource Loc.settings.title}" Style="{StaticResource TitleText}" />
                <TextBlock Text="{DynamicResource Loc.settings.subtitle}"
                           Style="{StaticResource MutedText}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="{DynamicResource Loc.settings.save}"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimarySmallButton}"
                    Width="148"
                    VerticalAlignment="Top" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,20,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource PanelBorder}" Margin="0,0,16,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <TextBlock Text="{DynamicResource Loc.settings.sections}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{DynamicResource Loc.settings.sectionsHint}"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Sections}"
                             SelectedItem="{Binding SelectedSection}"
                             ItemContainerStyle="{StaticResource SettingsNavItem}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}"
                                               Style="{StaticResource MutedText}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <StackPanel Visibility="{Binding GeneralSectionVisibility}">
                        <Border Style="{StaticResource WorkspacePanel}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Loc.settings.section.general.title}" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="{DynamicResource Loc.settings.general.description}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,6,0,18"
                                           TextWrapping="Wrap" />

                                <UniformGrid Columns="2">
                                    <Border Style="{StaticResource MetricPanel}" Margin="0,0,8,0">
                                        <StackPanel>
                                            <CheckBox Content="{DynamicResource Loc.settings.general.startMinimized}"
                                                      IsChecked="{Binding Settings.StartMinimizedToTray}" />
                                            <CheckBox Content="{DynamicResource Loc.settings.general.closeToTray}"
                                                      IsChecked="{Binding Settings.MinimizeToTrayOnClose}"
                                                      Margin="0,12,0,0" />
                                            <CheckBox Content="{DynamicResource Loc.settings.general.firstRunCompleted}"
                                                      IsChecked="{Binding Settings.FirstRunCompleted}"
                                                      Margin="0,12,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource MetricPanel}" Margin="8,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc.settings.general.portableStorage}" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="{Binding ConfigDirectory}"
                                                       TextWrapping="Wrap"
                                                       FontWeight="SemiBold" />
                                            <Button Content="{DynamicResource Loc.settings.openConfig}"
                                                    Command="{Binding OpenConfigFolderCommand}"
                                                    Style="{StaticResource GhostButton}"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,14,0,0" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding ScreenshotsSectionVisibility}">
                        <Border Style="{StaticResource WorkspacePanel}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Loc.settings.section.screenshots.title}" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="{DynamicResource Loc.settings.screenshots.description}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,6,0,18" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="{DynamicResource Loc.settings.screenshots.defaultMode}" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding ScreenshotModeOptions}"
                                                  SelectedValue="{Binding Settings.Screenshots.DefaultMode}"
                                                  SelectedValuePath="Value"
                                                  DisplayMemberPath="Label"
                                                  MinHeight="38" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                        <TextBlock Text="{DynamicResource Loc.settings.screenshots.format}" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding ImageFormatOptions}"
                                                  SelectedValue="{Binding Settings.Screenshots.DefaultFormat}"
                                                  SelectedValuePath="Value"
                                                  DisplayMemberPath="Label"
                                                  MinHeight="38" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                        <TextBlock Text="{DynamicResource Loc.settings.screenshots.monitor}" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding MonitorOptions}"
                                                  SelectedValue="{Binding Settings.Screenshots.MonitorIndex}"
                                                  SelectedValuePath="Value"
                                                  DisplayMemberPath="Label"
                                                  MinHeight="38" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.settings.screenshots.saveFolder}" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Settings.Screenshots.SaveDirectory, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <TextBlock Text="{DynamicResource Loc.settings.screenshots.jpegQuality}" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Settings.Screenshots.JpegQuality, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="14,0,0,0">
                                        <TextBlock Text="{DynamicResource Loc.settings.screenshots.delaySeconds}" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Settings.Screenshots.DelaySeconds, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Text="{DynamicResource Loc.settings.screenshots.fileNameTemplate}" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Settings.Screenshots.FileNameTemplate, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}" />
                                </StackPanel>

                                <Border Style="{StaticResource MetricPanel}" Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.settings.screenshots.pipeline}" Style="{StaticResource FieldLabel}" />
                                        <WrapPanel Margin="0,0,0,12">
                                            <Button Command="{Binding ApplyQuickCopyWorkflowCommand}"
                                                    Style="{StaticResource GhostButton}"
                                                    MinWidth="122"
                                                    Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" />
                                                    <TextBlock Text="{DynamicResource Loc.settings.workflow.copy}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding ApplyEditWorkflowCommand}"
                                                    Style="{StaticResource GhostButton}"
                                                    MinWidth="132"
                                                    Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" />
                                                    <TextBlock Text="{DynamicResource Loc.settings.workflow.editor}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding ApplyAiWorkflowCommand}"
                                                    Style="{StaticResource GhostButton}"
                                                    MinWidth="116"
                                                    Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="AI" FontWeight="Bold" Margin="0,0,7,0" />
                                                    <TextBlock Text="{DynamicResource Loc.settings.workflow.ask}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding ApplySilentSaveWorkflowCommand}"
                                                    Style="{StaticResource GhostButton}"
                                                    MinWidth="152"
                                                    Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" />
                                                    <TextBlock Text="{DynamicResource Loc.settings.workflow.silentFile}" />
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                        <UniformGrid Columns="3">
                                            <CheckBox Content="{DynamicResource Loc.settings.workflow.clipboard}"
                                                      IsChecked="{Binding CopyAfterCapture}"
                                                      Margin="0,0,10,10" />
                                            <CheckBox Content="{DynamicResource Loc.settings.workflow.saveFile}"
                                                      IsChecked="{Binding SaveAfterCapture}"
                                                      Margin="0,0,10,10" />
                                            <CheckBox Content="{DynamicResource Loc.settings.workflow.quickMenu}"
                                                      IsChecked="{Binding QuickActionsAfterCapture}"
                                                      Margin="0,0,0,10" />
                                            <CheckBox Content="{DynamicResource Loc.settings.workflow.openEditor}"
                                                      IsChecked="{Binding OpenEditorAfterCapture}"
                                                      Margin="0,0,10,0" />
                                            <CheckBox Content="{DynamicResource Loc.settings.workflow.askAi}"
                                                      IsChecked="{Binding AskAiAfterCapture}"
                                                      Margin="0,0,10,0" />
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding EditorSectionVisibility}">
                        <Border Style="{StaticResource WorkspacePanel}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Loc.settings.section.editor.title}" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="{DynamicResource Loc.settings.editor.description}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,6,0,18" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.settings.editor.color}" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Settings.Editor.DefaultColor, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <TextBlock Text="{DynamicResource Loc.settings.editor.thickness}" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Settings.Editor.DefaultStrokeThickness, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="14,0,0,0">
                                        <TextBlock Text="{DynamicResource Loc.settings.editor.textSize}" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Settings.Editor.DefaultTextSize, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="14,0,0,0">
                                        <TextBlock Text="{DynamicResource Loc.settings.editor.highlighterOpacity}" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Settings.Editor.HighlighterOpacity, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding AiSectionVisibility}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource WorkspacePanel}" Margin="0,0,16,0">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                        <TextBlock Text="{DynamicResource Loc.settings.section.ai.title}" Style="{StaticResource SectionTitleText}" />
                                        <TextBlock Text="{DynamicResource Loc.settings.ai.activeRoute}"
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>

                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="{DynamicResource Loc.settings.add}"
                                                Command="{Binding AddProviderCommand}"
                                                Style="{StaticResource GhostButton}"
                                                Margin="0,0,8,0" />
                                        <Button Content="{DynamicResource Loc.settings.delete}"
                                                Command="{Binding DeleteProviderCommand}"
                                                Style="{StaticResource GhostButton}" />
                                    </StackPanel>

                                    <ListBox ItemsSource="{Binding Providers}"
                                             SelectedItem="{Binding SelectedProvider}"
                                             BorderThickness="0"
                                             Background="Transparent">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ProviderListItem}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Model}"
                                                                   Style="{StaticResource MutedText}"
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource WorkspacePanel}">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedProvider.DisplayName}"
                                                       FontSize="22"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedProvider.Kind}"
                                                       Style="{StaticResource MutedText}" />
                                        </StackPanel>
                                        <CheckBox DockPanel.Dock="Right"
                                                  Content="{DynamicResource Loc.settings.enabled}"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding SelectedProvider.IsEnabled}" />
                                    </DockPanel>

                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc.settings.field.name}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding SelectedProvider.DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernTextBox}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                            <TextBlock Text="{DynamicResource Loc.settings.field.type}" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding AiProviderKindOptions}"
                                                      SelectedValue="{Binding SelectedProvider.Kind}"
                                                      SelectedValuePath="Value"
                                                      DisplayMemberPath="Label"
                                                      MinHeight="38" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,22,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="176" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc.settings.ai.endpoint}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding SelectedProvider.Endpoint, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernTextBox}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                            <TextBlock Text="{DynamicResource Loc.settings.ai.timeoutSeconds}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding SelectedProvider.TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernTextBox}" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,16,0,0">
                                        <TextBlock Text="{DynamicResource Loc.settings.ai.model}" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding SelectedProvider.Model, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}" />
                                    </StackPanel>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc.settings.ai.apiKey}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding ApiKeyInput, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernTextBox}" />
                                            <TextBlock Style="{StaticResource MutedText}"
                                                       FontSize="12"
                                                       Margin="0,6,0,0">
                                                <Run Text="{DynamicResource Loc.settings.ai.envVar}" />
                                                <Run Text=": " />
                                                <Run Text="{Binding SelectedProviderEnvironmentVariable, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="{DynamicResource Loc.settings.test}"
                                                Command="{Binding TestAiCommand}"
                                                Style="{StaticResource PrimarySmallButton}"
                                                Margin="14,22,0,0" />
                                    </Grid>

                                    <StackPanel Margin="0,18,0,0">
                                        <TextBlock Text="{DynamicResource Loc.settings.ai.systemPrompt}" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding SelectedProvider.SystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="110"
                                                 VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding PromptsSectionVisibility}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="288" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource WorkspacePanel}" Margin="0,0,16,0">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                        <TextBlock Text="{DynamicResource Loc.settings.section.prompts.title}" Style="{StaticResource SectionTitleText}" />
                                        <TextBlock Style="{StaticResource MutedText}"
                                                   Margin="0,4,0,0">
                                            <Run Text="{Binding PromptTemplateCount, Mode=OneWay}" />
                                            <Run Text=" " />
                                            <Run Text="{DynamicResource Loc.settings.prompts.templatesSuffix}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <Border DockPanel.Dock="Top"
                                            Style="{StaticResource MetricPanel}"
                                            Margin="0,0,0,12">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Text="{DynamicResource Loc.settings.prompts.categories}"
                                                           Style="{StaticResource FieldLabel}"
                                                           DockPanel.Dock="Left" />
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Content="+"
                                                            Command="{Binding AddPromptCategoryCommand}"
                                                            Style="{StaticResource GhostButton}"
                                                            Width="34"
                                                            MinWidth="34"
                                                            Padding="0"
                                                            Margin="0,0,6,0"
                                                            ToolTip="{DynamicResource Loc.settings.prompts.addCategory}" />
                                                    <Button Content="−"
                                                            Command="{Binding DeletePromptCategoryCommand}"
                                                            Style="{StaticResource GhostButton}"
                                                            Width="34"
                                                            MinWidth="34"
                                                            Padding="0"
                                                            ToolTip="{DynamicResource Loc.settings.prompts.deleteCategory}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <ListBox ItemsSource="{Binding PromptCategories}"
                                                     SelectedItem="{Binding SelectedPromptCategory}"
                                                     MaxHeight="150">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   Margin="9,7"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="{DynamicResource Loc.settings.add}"
                                                Command="{Binding AddPromptCommand}"
                                                Style="{StaticResource GhostButton}"
                                                Margin="0,0,8,0" />
                                        <Button Content="{DynamicResource Loc.settings.delete}"
                                                Command="{Binding DeletePromptCommand}"
                                                Style="{StaticResource GhostButton}" />
                                    </StackPanel>

                                    <ListBox ItemsSource="{Binding PromptTemplates}"
                                             SelectedItem="{Binding SelectedPromptTemplate}"
                                             BorderThickness="0"
                                             Background="Transparent">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ProviderListItem}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Prompt}"
                                                                   Style="{StaticResource MutedText}"
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource WorkspacePanel}">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc.settings.promptEditing}" Style="{StaticResource SectionTitleText}" />
                                            <TextBlock Text="{DynamicResource Loc.settings.prompts.savedToConfig}"
                                                       Style="{StaticResource MutedText}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Button DockPanel.Dock="Right"
                                                Content="{DynamicResource Loc.settings.restore}"
                                                Command="{Binding ResetPromptsCommand}"
                                                Style="{StaticResource GhostButton}" />
                                    </DockPanel>

                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc.settings.prompts.categoryName}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding SelectedPromptCategory.Name, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernTextBox}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  Content="{DynamicResource Loc.settings.prompts.system}"
                                                  IsChecked="{Binding SelectedPromptCategory.IsSystem}"
                                                  IsEnabled="False"
                                                  VerticalAlignment="Bottom"
                                                  Margin="14,0,0,8" />
                                    </Grid>

                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc.settings.field.name}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding SelectedPromptTemplate.Title, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernTextBox}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                            <TextBlock Text="{DynamicResource Loc.settings.field.category}" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding PromptCategories}"
                                                      SelectedValue="{Binding SelectedPromptTemplate.CategoryId}"
                                                      SelectedValuePath="Id"
                                                      DisplayMemberPath="Name"
                                                      MinHeight="38" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,16,0,0">
                                        <TextBlock Text="Prompt" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding SelectedPromptTemplate.Prompt, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="260"
                                                 VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding HotkeysSectionVisibility}">
                        <Border Style="{StaticResource WorkspacePanel}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <DockPanel>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc.settings.section.hotkeys.title}" Style="{StaticResource SectionTitleText}" />
                                            <TextBlock Style="{StaticResource MutedText}"
                                                       Margin="0,4,0,0">
                                                <Run Text="{Binding EnabledHotkeyCount, Mode=OneWay}" />
                                                <Run Text=" " />
                                                <Run Text="{DynamicResource Loc.settings.hotkeys.activeSuffix}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="{DynamicResource Loc.settings.hotkeys.validate}"
                                                    Command="{Binding ValidateHotkeysCommand}"
                                                    Style="{StaticResource GhostButton}"
                                                    Margin="0,0,8,0" />
                                            <Button Content="{DynamicResource Loc.settings.hotkeys.defaults}"
                                                    Command="{Binding RestoreDefaultHotkeysCommand}"
                                                    Style="{StaticResource GhostButton}" />
                                        </StackPanel>
                                    </DockPanel>

                                    <Border Style="{StaticResource MetricPanel}"
                                            Visibility="{Binding ValidationMessagesVisibility}"
                                            Margin="0,16,0,0">
                                        <ItemsControl ItemsSource="{Binding ValidationMessages}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               Foreground="{StaticResource WarningBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,0,6" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>

                                <ListBox ItemsSource="{Binding Hotkeys}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Margin="0,18,0,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource MetricPanel}" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="1.2*" />
                                                        <ColumnDefinition Width="178" />
                                                        <ColumnDefinition Width="210" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox IsChecked="{Binding IsEnabled}"
                                                              VerticalAlignment="Center" />

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding ActionDisplayName}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Description}"
                                                                   Style="{StaticResource MutedText}"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,3,0,0" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                                        <TextBlock Text="{DynamicResource Loc.settings.hotkeys.gesture}" Style="{StaticResource FieldLabel}" />
                                                        <TextBox Text="{Binding Gesture, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource ModernTextBox}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3" Margin="16,0,0,0">
                                                        <TextBlock Text="{DynamicResource Loc.settings.hotkeys.quickAiPrompt}" Style="{StaticResource FieldLabel}" />
                                                        <ComboBox ItemsSource="{Binding DataContext.PromptTemplates, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  SelectedValue="{Binding PromptTemplateId}"
                                                                  SelectedValuePath="Id"
                                                                  DisplayMemberPath="Title"
                                                                  MinHeight="38" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding InterfaceSectionVisibility}">
                        <Border Style="{StaticResource WorkspacePanel}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Loc.settings.section.interface.title}" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="{DynamicResource Loc.settings.interface.description}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,6,0,18" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.settings.interface.theme}" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="ThemeModeComboBox"
                                                  ItemsSource="{Binding ThemeModeOptions}"
                                                  SelectedValue="{Binding Settings.Theme.Mode}"
                                                  SelectedValuePath="Value"
                                                  DisplayMemberPath="Label"
                                                  MinHeight="38"
                                                  SelectionChanged="ThemeModeComboBox_OnSelectionChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <TextBlock Text="{DynamicResource Loc.settings.interface.accentColor}" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="AccentColorTextBox"
                                                 Text="{Binding Settings.Theme.AccentColor, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="AccentColorTextBox_OnTextChanged"
                                                 Style="{StaticResource ModernTextBox}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding LanguagesSectionVisibility}">
                        <Border Style="{StaticResource WorkspacePanel}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Loc.settings.section.languages.title}" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="{DynamicResource Loc.settings.languages.description}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,6,0,18"
                                           TextWrapping="Wrap" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc.settings.languages.uiLanguage}" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding LanguageOptions}"
                                                  SelectedValue="{Binding Settings.Language}"
                                                  SelectedValuePath="Value"
                                                  DisplayMemberPath="Label"
                                                  MinHeight="38" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource MetricPanel}" Margin="18,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc.settings.languages.folder}" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="{Binding LocalizationDirectory}"
                                                       TextWrapping="Wrap"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SecuritySectionVisibility}">
                        <Border Style="{StaticResource WorkspacePanel}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Loc.settings.section.security.title}" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="{DynamicResource Loc.settings.security.description}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,6,0,18"
                                           TextWrapping="Wrap" />

                                <Border Style="{StaticResource MetricPanel}">
                                    <StackPanel>
                                        <CheckBox Content="{DynamicResource Loc.settings.security.confirmBeforeSending}"
                                                  IsChecked="{Binding Settings.Ai.SendScreenshotsOnlyAfterConfirmation}" />
                                        <TextBlock Style="{StaticResource MutedText}"
                                                   Margin="0,12,0,0"
                                                   TextWrapping="Wrap">
                                            <Run Text="{DynamicResource Loc.settings.security.secrets}" />
                                            <Run Text=": " />
                                            <Run Text="{Binding SecretsFilePath, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding LogsSectionVisibility}">
                        <Border Style="{StaticResource WorkspacePanel}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Loc.settings.logsAndFiles}" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="{DynamicResource Loc.settings.logs.description}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,6,0,18" />

                                <UniformGrid Columns="3">
                                    <Border Style="{StaticResource MetricPanel}" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc.settings.logs.logs}" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="{Binding LogDirectory}"
                                                       TextWrapping="Wrap"
                                                       FontWeight="SemiBold" />
                                            <Button Content="{DynamicResource Loc.settings.open}"
                                                    Command="{Binding OpenLogsFolderCommand}"
                                                    Style="{StaticResource GhostButton}"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,14,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource MetricPanel}" Margin="10,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc.settings.logs.screenshots}" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="{Binding ScreenshotsDirectory}"
                                                       TextWrapping="Wrap"
                                                       FontWeight="SemiBold" />
                                            <Button Content="{DynamicResource Loc.settings.open}"
                                                    Command="{Binding OpenScreenshotsFolderCommand}"
                                                    Style="{StaticResource GhostButton}"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,14,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource MetricPanel}" Margin="10,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc.settings.logs.themes}" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="{Binding ThemesDirectory}"
                                                       TextWrapping="Wrap"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource MutedText}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis">
                <Run Text="{DynamicResource Loc.settings.general.config}" />
                <Run Text=": " />
                <Run Text="{Binding ConfigDirectory, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Grid.Column="1"
                       Text="{Binding Status}"
                       Style="{StaticResource MutedText}"
                       VerticalAlignment="Center"
                       Margin="18,0,0,0"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</Window>
