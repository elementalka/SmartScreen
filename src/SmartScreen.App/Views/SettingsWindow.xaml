<Window x:Class="SmartScreen.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Налаштування SmartScreen" Width="900" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="AI-провайдери" Style="{StaticResource TitleText}" />
            <TextBlock Text="{Binding ConfigDirectory}" Style="{StaticResource MutedText}" />
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Providers}"
                  SelectedItem="{Binding SelectedProvider}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  Margin="0,16"
                  RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Назва" Binding="{Binding DisplayName}" Width="1.4*" />
                <DataGridTextColumn Header="Тип" Binding="{Binding Kind}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="2*" />
                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="1.4*" />
                <DataGridTextColumn Header="API key" Binding="{Binding ApiKey}" Width="1.4*" />
                <DataGridCheckBoxColumn Header="Увімкн." Binding="{Binding IsEnabled}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2">
            <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Тест AI" Command="{Binding TestAiCommand}" Margin="8,0,0,0" />
                <Button Content="Зберегти" Command="{Binding SaveCommand}" Margin="8,0,0,0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>

