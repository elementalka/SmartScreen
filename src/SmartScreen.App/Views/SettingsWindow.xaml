<Window x:Class="SmartScreen.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Налаштування SmartScreen" Width="980" Height="680"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel>
                <TextBlock Text="Налаштування" Style="{StaticResource TitleText}" />
                <TextBlock Text="AI-провайдери, ключі, endpoint-и та локальні portable-конфіги"
                           Style="{StaticResource MutedText}" />
            </StackPanel>
            <Button DockPanel.Dock="Right"
                    Content="Зберегти"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimarySmallButton}" />
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,24,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource PanelBorder}" Margin="0,0,18,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Провайдери" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="Вибери активний AI-маршрут"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,6,0,14" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Providers}"
                             SelectedItem="{Binding SelectedProvider}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ProviderListItem}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Model}"
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedProvider.DisplayName, TargetNullValue=AI provider}"
                                       FontSize="22"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedProvider.Kind}"
                                       Style="{StaticResource MutedText}" />
                        </StackPanel>
                        <CheckBox DockPanel.Dock="Right"
                                  Content="Увімкнено"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding SelectedProvider.IsEnabled}" />
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Endpoint" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding SelectedProvider.Endpoint, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="Timeout, sec" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding SelectedProvider.TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <TextBlock Text="Model" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding SelectedProvider.Model, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}" />
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="API key" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ApiKeyInput, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     ToolTip="Ключ зберігається локально в config/secrets.local.json і не потрапляє в git." />
                            <TextBlock Text="{Binding SelectedProviderEnvironmentVariable, StringFormat=Env var: {0}}"
                                       Style="{StaticResource MutedText}"
                                       FontSize="12"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Тест"
                                Command="{Binding TestAiCommand}"
                                Style="{StaticResource PrimarySmallButton}"
                                Margin="14,22,0,0" />
                    </Grid>

                    <Border Grid.Row="4"
                            Style="{StaticResource MetricPanel}"
                            Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Pipeline після скріншоту" Style="{StaticResource FieldLabel}" />
                            <UniformGrid Columns="3" Margin="0,4,0,0">
                                <CheckBox Content="Буфер"
                                          IsChecked="{Binding CopyAfterCapture}"
                                          Margin="0,0,10,8" />
                                <CheckBox Content="Файл"
                                          IsChecked="{Binding SaveAfterCapture}"
                                          Margin="0,0,10,8" />
                                <CheckBox Content="Швидке меню"
                                          IsChecked="{Binding QuickActionsAfterCapture}"
                                          Margin="0,0,0,8" />
                                <CheckBox Content="Редактор"
                                          IsChecked="{Binding OpenEditorAfterCapture}"
                                          Margin="0,0,10,0" />
                                <CheckBox Content="AI-запит"
                                          IsChecked="{Binding AskAiAfterCapture}"
                                          Margin="0,0,10,0" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="5" Margin="0,18,0,0">
                        <TextBlock Text="System prompt" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding SelectedProvider.SystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="94"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2">
            <TextBlock Text="{Binding ConfigDirectory, StringFormat=Config: {0}}"
                       Style="{StaticResource MutedText}"
                       VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Right"
                       Text="{Binding Status}"
                       Style="{StaticResource MutedText}"
                       VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
