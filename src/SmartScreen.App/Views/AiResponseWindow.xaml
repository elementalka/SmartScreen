<Window x:Class="SmartScreen.App.Views.AiResponseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI-відповідь"
        Width="900"
        Height="700"
        MinWidth="780"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="AI-аналіз скріншота" Style="{StaticResource TitleText}" />
                <TextBlock Text="{Binding Status}"
                           Style="{StaticResource MutedText}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <Button DockPanel.Dock="Right"
                    Content="AI settings"
                    Command="{Binding OpenSettingsCommand}"
                    Style="{StaticResource GhostButton}" />
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource WorkspacePanel}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Prompt-шаблон" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Prompts}"
                              SelectedItem="{Binding SelectedPrompt}"
                              DisplayMemberPath="Title"
                              MinHeight="38" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Prompt" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding CustomPrompt, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="88"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource WorkspacePanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Відповідь" Style="{StaticResource SectionTitleText}" />
                <TextBox Grid.Row="1"
                         Text="{Binding ResponseText, Mode=OneWay}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         BorderThickness="0"
                         Background="Transparent"
                         Margin="0,12,0,0" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="{Binding Status}"
                       Style="{StaticResource MutedText}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Запитати"
                        Command="{Binding AskCommand}"
                        Style="{StaticResource PrimarySmallButton}"
                        Margin="8,0,0,0" />
                <Button Content="Скасувати"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource GhostButton}"
                        Margin="8,0,0,0" />
                <Button Content="Копіювати"
                        Command="{Binding CopyCommand}"
                        Style="{StaticResource GhostButton}"
                        Margin="8,0,0,0" />
                <Button Content="Save .txt"
                        Command="{Binding SaveResponseCommand}"
                        Style="{StaticResource GhostButton}"
                        Margin="8,0,0,0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
