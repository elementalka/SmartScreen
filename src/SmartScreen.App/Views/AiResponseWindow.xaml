<Window x:Class="SmartScreen.App.Views.AiResponseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI-відповідь" Width="760" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="120" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ComboBox ItemsSource="{Binding Prompts}"
                  SelectedItem="{Binding SelectedPrompt}"
                  DisplayMemberPath="Title"
                  MinHeight="36" />

        <TextBox Grid.Row="1"
                 Text="{Binding CustomPrompt, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Margin="0,12,0,12" />

        <TextBox Grid.Row="2"
                 Text="{Binding ResponseText}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Запитати" Command="{Binding AskCommand}" Margin="8,0,0,0" />
                <Button Content="Скасувати" Command="{Binding CancelCommand}" Margin="8,0,0,0" />
                <Button Content="Копіювати" Command="{Binding CopyCommand}" Margin="8,0,0,0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>

