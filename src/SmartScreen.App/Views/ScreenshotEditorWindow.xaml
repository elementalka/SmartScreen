<Window x:Class="SmartScreen.App.Views.ScreenshotEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор скріншота" Width="1100" Height="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Олівець" Click="PenButton_OnClick" />
            <Button Content="Маркер" Click="HighlighterButton_OnClick" />
            <Separator />
            <Button Content="Undo" Click="UndoButton_OnClick" />
            <Button Content="Очистити" Click="ClearButton_OnClick" />
            <Separator />
            <Button Content="Готово" Click="DoneButton_OnClick" />
            <Button Content="Скасувати" Click="CancelButton_OnClick" />
        </ToolBar>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="EditingSurface" Background="Transparent">
                <Image x:Name="ScreenshotImage" Stretch="Fill" />
                <InkCanvas x:Name="InkCanvas"
                           Background="Transparent"
                           EditingMode="Ink" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>

