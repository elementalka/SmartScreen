<Window x:Class="SmartScreen.App.Views.ScreenshotEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор скріншота" Width="1180" Height="780"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        Background="{StaticResource AppBackgroundBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="14,10">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Pen" Click="PenButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="P" />
                    <Button Content="Marker" Click="HighlighterButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="M" />
                    <Button Content="Line" Click="LineButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="L" />
                    <Button Content="Arrow" Click="ArrowButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="A" />
                    <Button Content="Rect" Click="RectangleButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="R" />
                    <Button Content="Ellipse" Click="EllipseButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="E" />
                    <Button Content="Text" Click="TextButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="T" />
                    <Button Content="Crop" Click="CropButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="C" />
                    <Separator Margin="8,0" />
                    <Button Content="Undo" Click="UndoButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="Ctrl+Z" />
                    <Button Content="Redo" Click="RedoButton_OnClick" Style="{StaticResource EditorToolButton}" ToolTip="Ctrl+Y" />
                    <Button Content="Clear" Click="ClearButton_OnClick" Style="{StaticResource EditorToolButton}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Готово" Click="DoneButton_OnClick" Style="{StaticResource PrimarySmallButton}" />
                    <Button Content="Скасувати" Click="CancelButton_OnClick" Style="{StaticResource EditorToolButton}" Margin="8,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#DDE3EE">
            <Grid x:Name="EditingSurface" Background="Transparent">
                <Image x:Name="ScreenshotImage" Stretch="Fill" />
                <Canvas x:Name="AnnotationCanvas"
                        Background="Transparent"
                        MouseLeftButtonDown="AnnotationCanvas_OnMouseLeftButtonDown"
                        MouseMove="AnnotationCanvas_OnMouseMove"
                        MouseLeftButtonUp="AnnotationCanvas_OnMouseLeftButtonUp" />
                <InkCanvas x:Name="InkCanvas"
                           Background="Transparent"
                           EditingMode="Ink" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
